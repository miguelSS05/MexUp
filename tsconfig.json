{
	"compilerOptions": {
		"target": "es2019",
		"module": "commonjs",
		"pretty": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"noImplicitAny": false,
		"esModuleInterop": true,
		"preserveConstEnums": true,
		"experimentalDecorators":true,
		"alwaysStrict": true,
		"forceConsistentCasingInFileNames": true,
		"emitDecoratorMetadata": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules"
	],
	"files":[
		"node_modules/@types/node/index.d.ts"
	]
}
